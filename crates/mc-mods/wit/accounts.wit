package rustmc:plugin@1.0.0;

/// Reserved host-owned interface. Credentials and session tokens never cross this boundary.
/// The current runtime does not link this interface yet.
interface accounts {
  enum account-kind { offline, microsoft }
  variant ban-status { none, temporary(u64), permanent }
  record account { id: string, username: string, uuid: option<string>, kind: account-kind, ban: ban-status }
  variant operation-state { pending, complete, failed(string) }
  %list: func() -> list<account>;
  current: func() -> option<string>;
  launch: func() -> option<string>;
  activate: func(id: string) -> result<u32, string>;
  restore-launch: func() -> result<u32, string>;
  remove: func(id: string) -> result<_, string>;
  initiate-add: func(kind: account-kind) -> result<u32, string>;
  operation: func(id: u32) -> option<operation-state>;
  move-before: func(id: string, before: option<string>) -> result<_, string>;
  set-ban-status: func(id: string, status: ban-status) -> result<_, string>;
}
